{
  "name": "rolldown-plugin-claude-code",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @kwitsch/e2e test:e2e",
    "typecheck": "pnpm -r typecheck",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "oxlint",
    "hook-types:check": "node packages/cli/dist/index.mjs --check fixtures/mcp-hook/hooks.template.json",
    "mod:check": "node packages/cli/dist/check-mod-bin.mjs fixtures/mod-and-script/expected/hooks/hooks.json",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm --filter \"./packages/*\" build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "dprint": "0.65.0",
    "oxlint": "1.94.0"
  },
  "packageManager": "pnpm@11.20.0"
}
